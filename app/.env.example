# Add real values only in local .env.local or production host environment variables.
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
GITHUB_TOKEN=your_github_token_here
# Optional Google OAuth for user login
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Must exactly match the URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/user/auth/google/callback

# --- Vercel ---
# On Vercel set all of the above in Project Settings → Environment Variables.
# Set them for Production, Preview and Development as needed. Public URLs must be
# the deployed HTTPS origin, e.g.:
#   GOOGLE_REDIRECT_URI=https://<your-app>.vercel.app/api/user/auth/google/callback
